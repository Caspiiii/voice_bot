# Server-only secrets. Do not expose these as NEXT_PUBLIC_* values.
OPENAI_API_KEY=sk-proj-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL=gpt-4.1-mini

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ADMIN_PASSWORD=replace-with-a-long-random-password

# Browser voice calls. These two values are safe to expose to the browser.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your-vapi-assistant-id

# Optional shared secret for the Vapi custom tool endpoint.
VAPI_TOOL_SECRET=replace-with-another-long-random-password
